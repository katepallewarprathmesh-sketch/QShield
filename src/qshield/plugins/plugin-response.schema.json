{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qshield.dev/schemas/plugin-response-1.json",
  "title": "QSHIELD Detector Plugin Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "findings"],
  "properties": {
    "api_version": { "const": "1" },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 64 },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "gate_ids": { "type": "array", "maxItems": 1000, "items": { "type": "string" } }
        }
      }
    }
  }
}
