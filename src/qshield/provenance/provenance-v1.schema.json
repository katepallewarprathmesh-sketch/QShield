{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/katepallewarprathmesh-sketch/QShield/blob/main/src/qshield/provenance/provenance-v1.schema.json",
  "title": "QSHIELD Offline Provenance Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "created_utc", "subject", "toolchain"],
  "properties": {
    "spec_version": {"const": "qshield-provenance-v1"},
    "created_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "source_sha256", "canonicalization_spec", "circuit_sha256"],
      "properties": {
        "format": {"type": "string", "pattern": "^openqasm-[0-9]+(\\.[0-9]+)?$"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonicalization_spec": {"const": "qshield-circuit-c14n-v1"},
        "circuit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "value": {"type": "string", "contentEncoding": "base64"}
      }
    }
  }
}
